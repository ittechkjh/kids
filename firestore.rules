rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Platform Architecture
    // ===============================================================
    // Application: DodamTalk (도담톡 - 대한민국 육아 & 우리동네 커뮤니티)
    // Architecture: Pure Frontend Static Web App (GitHub Pages) with Cloud Firestore
    // Authentication: Client-side custom session/user identity state (Firebase Auth unrequired)
    //
    // Collections Secured & Synced:
    // ---------------------------------------------------------------
    // 1. community_posts/{postId}
    //    Fields: id, title, content, contentHtml, rawTextContent, category,
    //            guideType, ageStage, region, localHub, localHubName, localTopic,
    //            localTopicName, isQuestion, isSolved, isHot, isAiReport, isEdited,
    //            images, author, createdAt, updatedAt, timestamp, views,
    //            reactions, tags, comments, userReaction
    //    Operations: read, create, update, delete
    //
    // 2. deleted_posts/{postId}
    //    Fields: id, deletedAt, reason, deletedBy
    //    Operations: read, create, update, delete
    //
    // 3. post_drafts/{draftId}
    //    Fields: id, title, category, region, ageStage, localHub, localTopic,
    //            isQuestion, content, savedAt, updatedAt, authorId
    //    Operations: read, create, update, delete
    //
    // 4. user_profiles/{profileId}
    //    Fields: id, nickname, region, subRegion, children, pregnancyDue,
    //            interests, growthLogs, points, level, updatedAt, createdAt
    //    Operations: read, create, update, delete
    //
    // 5. user_scraps/{scrapId}
    //    Fields: id, userId, items, updatedAt, createdAt
    //    Operations: read, create, update, delete
    //
    // 6. users/{userId}
    //    Fields: id, name, email, provider, role, status, region, subRegion,
    //            children, joinedAt, updatedAt
    //    Operations: read, create, update, delete
    //
    // 7. user_sessions/{sessionId}
    //    Fields: id, user, token, updatedAt, createdAt
    //    Operations: read, create, update, delete
    //
    // 8. user_events/{eventId}
    //    Fields: id, title, category, categoryName, boardType, region, regionName,
    //            subRegion, location, startDate, endDate, applyStartDate, applyEndDate,
    //            ageMin, ageMax, fee, organizer, image, imageUrl, summary,
    //            description, tags, url, badge, status, dday, targetAudience,
    //            isUserCreated, createdAt, updatedAt
    //    Operations: read, create, update, delete
    //
    // 9. user_restaurants/{restaurantId}
    //    Fields: id, name, category, categoryName, region, regionName, subRegion,
    //            district, location, address, phone, hours, parking, Menu,
    //            representativeMenu, features, amenities, image, imageUrl,
    //            summary, reviewSummary, isYesKids, rating, overallRating,
    //            reviews, reviewCount, isUserCreated, authorName, authorId,
    //            lat, lng, sources, isCrawled, crawledAt, createdAt, updatedAt
    //    Operations: read, create, update, delete
    //
    // 10. app_config/{configId}
    //    Fields: kakaoJsKey, naverClientId, googleClientId, proxyUrl,
    //            dataGoKrKey, data4LibraryKey, updatedAt, version
    //    Operations: read, create, update, delete
    // ===============================================================

    // Helper functions for content limits & resource protection
    function isAllowedString(str, maxLen) {
      return str is string && str.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // ---------------------------------------------------------------
    // 1. community_posts
    // ---------------------------------------------------------------
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.title is string &&
                       request.resource.data.title.size() <= 300 &&
                       (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 500000)) &&
                       (!('contentHtml' in request.resource.data) || (request.resource.data.contentHtml is string && request.resource.data.contentHtml.size() <= 500000));
      allow update: if (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 300)) &&
                       (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 500000)) &&
                       (!('contentHtml' in request.resource.data) || (request.resource.data.contentHtml is string && request.resource.data.contentHtml.size() <= 500000));
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 2. deleted_posts
    // Tracks tombstone IDs so deleted posts do not reappear from seed files
    // ---------------------------------------------------------------
    match /deleted_posts/{postId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 3. post_drafts
    // Temporary drafts for writing community articles and inquiries
    // ---------------------------------------------------------------
    match /post_drafts/{draftId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 4. user_profiles
    // User profile, child growth log entries & customized settings
    // ---------------------------------------------------------------
    match /user_profiles/{profileId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 5. user_scraps
    // User bookmarks and scrapped posts/events/places
    // ---------------------------------------------------------------
    match /user_scraps/{scrapId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 6. users
    // Registered user profiles and credentials
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 7. user_sessions
    // Active login session states across devices
    // ---------------------------------------------------------------
    match /user_sessions/{sessionId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 8. user_events
    // User-registered regional festivals, programs, and contests
    // ---------------------------------------------------------------
    match /user_events/{eventId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 9. user_restaurants
    // User-registered kids-friendly restaurants and family dining places
    // ---------------------------------------------------------------
    match /user_restaurants/{restaurantId} {
      allow read, create, update, delete: if true;
    }

    // ---------------------------------------------------------------
    // 10. app_config
    // Public app configuration & third-party SDK client credentials
    // ---------------------------------------------------------------
    match /app_config/{configId} {
      allow read, create, update, delete: if true;
    }

    // Global default fallback: deny any unexpected collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
